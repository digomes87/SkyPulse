{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/digomes87/SkyPulse/contracts/flight-schedule.v1.json",
  "title": "flight_schedule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "produced_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Deterministic UUIDv5 of the natural key; re-ingesting the same observation yields the same id."
    },
    "event_type": {
      "const": "flight_schedule"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "enum": [
        "aerodatabox",
        "replay"
      ]
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flight_number",
        "callsign",
        "airline_name",
        "airline_iata",
        "airline_icao",
        "origin_icao",
        "destination_icao",
        "scheduled_departure_utc",
        "scheduled_arrival_utc",
        "revised_departure_utc",
        "revised_arrival_utc",
        "runway_departure_utc",
        "runway_arrival_utc",
        "status",
        "is_cargo",
        "observed_at"
      ],
      "properties": {
        "flight_number": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,3}[0-9]{1,4}[A-Z]?$",
          "description": "Marketing flight number without spaces, e.g. FR123."
        },
        "callsign": {
          "type": [
            "string",
            "null"
          ]
        },
        "airline_name": {
          "type": "string"
        },
        "airline_iata": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9]{2}$"
        },
        "airline_icao": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "origin_icao": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "destination_icao": {
          "type": "string",
          "pattern": "^[A-Z0-9]{4}$"
        },
        "scheduled_departure_utc": {
          "type": "string",
          "format": "date-time"
        },
        "scheduled_arrival_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revised_departure_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revised_arrival_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "runway_departure_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "runway_arrival_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "enum": [
            "Unknown",
            "Expected",
            "EnRoute",
            "CheckIn",
            "Boarding",
            "GateClosed",
            "Departed",
            "Delayed",
            "Approaching",
            "Arrived",
            "Canceled",
            "Diverted",
            "CanceledUncertain"
          ]
        },
        "is_cargo": {
          "type": "boolean"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "description": "When SkyPulse fetched this version of the flight from the provider."
        }
      }
    }
  }
}
