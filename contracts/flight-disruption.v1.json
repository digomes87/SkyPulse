{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/digomes87/SkyPulse/contracts/flight-disruption.v1.json",
  "title": "flight_disruption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "source",
    "produced_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Deterministic UUIDv5 of the natural key; re-ingesting the same observation yields the same id."
    },
    "event_type": {
      "const": "flight_disruption"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "enum": [
        "skypulse-detector"
      ]
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flight_number",
        "airline_icao",
        "airline_country",
        "origin",
        "destination",
        "scheduled_departure_utc",
        "scheduled_arrival_utc",
        "actual_departure_utc",
        "actual_arrival_utc",
        "kind",
        "status",
        "departure_delay_minutes",
        "arrival_delay_minutes",
        "detected_at",
        "origin_weather",
        "destination_weather"
      ],
      "properties": {
        "flight_number": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,3}[0-9]{1,4}[A-Z]?$"
        },
        "airline_icao": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$"
        },
        "airline_country": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "icao",
            "country",
            "latitude",
            "longitude"
          ],
          "properties": {
            "icao": {
              "type": "string",
              "pattern": "^[A-Z0-9]{4}$"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{2}$"
            },
            "latitude": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "destination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "icao",
            "country",
            "latitude",
            "longitude"
          ],
          "properties": {
            "icao": {
              "type": "string",
              "pattern": "^[A-Z0-9]{4}$"
            },
            "country": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Z]{2}$"
            },
            "latitude": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": [
                "number",
                "null"
              ],
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "scheduled_departure_utc": {
          "type": "string",
          "format": "date-time"
        },
        "scheduled_arrival_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actual_departure_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "actual_arrival_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "departure_delay",
            "arrival_delay",
            "cancellation"
          ],
          "description": "departure_delay is an early warning; arrival_delay and cancellation are final outcomes."
        },
        "status": {
          "type": "string"
        },
        "departure_delay_minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "arrival_delay_minutes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        },
        "origin_weather": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "present_weather",
              "visibility_m",
              "wind_direction_degrees",
              "wind_speed_kt",
              "wind_gust_kt"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "present_weather": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "visibility_m": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "wind_direction_degrees": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 360
              },
              "wind_speed_kt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "wind_gust_kt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "description": "METAR at the origin within an hour of the scheduled departure."
        },
        "destination_weather": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "present_weather",
              "visibility_m",
              "wind_direction_degrees",
              "wind_speed_kt",
              "wind_gust_kt"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "format": "date-time"
              },
              "present_weather": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "visibility_m": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "wind_direction_degrees": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 360
              },
              "wind_speed_kt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "wind_gust_kt": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "description": "METAR at the destination within an hour of the scheduled arrival."
        }
      }
    }
  }
}
