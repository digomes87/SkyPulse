# Copy to .env and adjust. Every SkyPulse setting uses the SKYPULSE_ prefix,
# nested values use a double underscore.
SKYPULSE_RUN_MODE=local
SKYPULSE_LOG_LEVEL=INFO
SKYPULSE_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
SKYPULSE_AWS__REGION=eu-west-1
SKYPULSE_LAKE__BUCKET_PREFIX=skypulse

# Only needed with a LocalStack image newer than 4.14.0
# LOCALSTACK_IMAGE=localstack/localstack:2026.10.0
# LOCALSTACK_AUTH_TOKEN=

# boto3 needs credentials even for LocalStack; any value works locally
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
